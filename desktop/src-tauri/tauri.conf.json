{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atom Forge",
  "version": "0.93.0",
  "identifier": "app.atomforge.desktop",
  "build": {
    "beforeBuildCommand": "node ../build.js && node ../tools/stage-app.js",
    "frontendDist": "../dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Atom Forge", "width": 1440, "height": 920, "minWidth": 900, "minHeight": 600, "resizable": true, "center": true }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
